# ==========================================
# CadastreCheck Environment Variables
# ==========================================

# Пути к данным (относительно корня проекта)
DATA_DIR=data
CACHE_DIR=data/cache
IMAGERY_DIR=data/imagery

# Настройки НСПД (Национальная система пространственных данных)
# Если API требует токены или специфические URL, укажите их здесь
NSPD_API_BASE_URL=https://nspd.gov.ru/api/
NSPD_RATE_LIMIT=1.5
NSPD_TIMEOUT=30

# Настройки ESRI World Imagery
ESRI_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Режимы работы
USE_CACHE=True
LOG_LEVEL=INFO